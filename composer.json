{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tacticalninj4/dbexplorer",
    "description": "Laravel DB Explorer for web",
    "keywords": [
        "laravel",
        "tacticalninj4",
        "dbexplorer"
    ],
    "homepage": "https://github.com/tacticalninj4/dbexplorer",
    "license": "MIT",
    "authors": [
        {
            "name": "Jhanarthananraja",
            "email": "jhanarthananraja@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/auth": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/console": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/contracts": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/database": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/http": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/queue": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/routing": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^9.0||^10.0||^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^7.0||^8.0||^9.0||^10.6||^11.0",
        "pestphp/pest": "^1.23||^2.0||^3.0||^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^1.4||^2.0||^3.0||^4.0||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "ext-pdo_pgsql": "Required to connect to PostgreSQL databases."
    },
    "autoload": {
        "psr-4": {
            "TacticalNinj4\\DbExplorer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TacticalNinj4\\DbExplorer\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "TacticalNinj4\\DbExplorer\\DbExplorerServiceProvider"
            ],
            "aliases": {
                "DbExplorer": "TacticalNinj4\\DbExplorer\\Facades\\DbExplorer"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
