parameters:
    level: 7
    phpVersion: 80000
    paths:
        - src
        - %currentWorkingDirectory%/config
        - database
        - routes
    tmpDir: build/phpstan
    configDirectories:
        - %currentWorkingDirectory%/config
    # Typed class constants need PHP 8.3; the package supports PHP 8.0.
    type_coverage:
        constant_type: 0
