parameters:
    level: 7
    phpVersion: 80000
    paths:
        - src
        - config
        - database
        - routes
    tmpDir: build/phpstan
    # Larastan only treats the host app's config_path() as config; the package config lives here.
    configDirectories:
        - config
    type_coverage:
        # Typed class constants need PHP 8.3; the source must stay PHP 8.0 compatible.
        constant_type: 0
